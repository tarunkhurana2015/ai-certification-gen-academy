      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"favorites\" (\"movie_id\" INTEGER NOT NULL CHECK(movie_id > 0), \"title\" TEXT NOT NULL CHECK(length(trim(title)) > 0), \"original_title\" TEXT NULL, \"poster_path\" TEXT NULL, \"backdrop_path\" TEXT NULL, \"release_date\" TEXT NULL, \"vote_average\" REAL NULL, \"vote_count\" INTEGER NULL, \"added_order\" INTEGER NOT NULL UNIQUE CHECK(added_order > 0), \"added_at_utc\" INTEGER NOT NULL, PRIMARY KEY (\"movie_id\"), CHECK((vote_average IS NULL AND vote_count IS NULL) OR (vote_average IS NOT NULL AND vote_count IS NOT NULL AND vote_average BETWEEN 0 AND 10 AND vote_count > 0)));"
        }
      ]
